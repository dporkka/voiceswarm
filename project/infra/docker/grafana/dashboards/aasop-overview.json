{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"aasop-api\"}[5m])",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "xaxis": {"mode": "time"},
      "yaxes": [
        {"format": "reqps", "label": "Requests/sec"},
        {"format": "short"}
      ],
      "lines": true,
      "linewidth": 1,
      "fill": 1
    },
    {
      "id": 2,
      "title": "API Response Time (p99)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"aasop-api\"}[5m]))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"aasop-api\"}[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Seconds"},
        {"format": "short"}
      ],
      "lines": true,
      "linewidth": 1,
      "fill": 1
    },
    {
      "id": 3,
      "title": "CPU Usage",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"api|web|agent-runtime|workflow-worker\"}[5m])",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "percentunit", "label": "CPU %"},
        {"format": "short"}
      ],
      "lines": true,
      "linewidth": 1,
      "fill": 1
    },
    {
      "id": 4,
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=~\"api|web|agent-runtime|workflow-worker\"} / 1024 / 1024",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "mbytes", "label": "MB"},
        {"format": "short"}
      ],
      "lines": true,
      "linewidth": 1,
      "fill": 1
    },
    {
      "id": 5,
      "title": "Active Agents",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "aasop_agents_active_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Workflow Executions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
      "targets": [
        {
          "expr": "rate(aasop_workflows_executed_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Error Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"aasop-api\",status=~\"5..\"}[5m])",
          "legendFormat": "5xx errors",
          "refId": "A"
        },
        {
          "expr": "rate(http_requests_total{job=\"aasop-api\",status=~\"4..\"}[5m])",
          "legendFormat": "4xx errors",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Errors/sec"},
        {"format": "short"}
      ],
      "lines": true,
      "linewidth": 1,
      "fill": 1
    },
    {
      "id": 8,
      "title": "NATS Messages",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "nats_server_messages_total",
          "legendFormat": "Messages",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Messages"},
        {"format": "short"}
      ],
      "lines": true,
      "linewidth": 1,
      "fill": 1
    }
  ],
  "refresh": "5s",
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["aasop"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "AASOP Platform Overview",
  "uid": "aasop-overview",
  "version": 1
}
