{
  "name": "@aasop/observability",
  "version": "0.1.0",
  "description": "OpenTelemetry tracing, Prometheus metrics, and structured logging for AASOP",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./tracing": {
      "import": "./dist/tracing/index.js",
      "require": "./dist/tracing/index.cjs",
      "types": "./dist/tracing/index.d.ts"
    },
    "./metrics": {
      "import": "./dist/metrics/index.js",
      "require": "./dist/metrics/index.cjs",
      "types": "./dist/metrics/index.d.ts"
    },
    "./logging": {
      "import": "./dist/logging/index.js",
      "require": "./dist/logging/index.cjs",
      "types": "./dist/logging/index.d.ts"
    },
    "./fastify-plugin": {
      "import": "./dist/fastify-plugin.js",
      "require": "./dist/fastify-plugin.cjs",
      "types": "./dist/fastify-plugin.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/tracing/index.ts src/metrics/index.ts src/logging/index.ts src/fastify-plugin.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/tracing/index.ts src/metrics/index.ts src/logging/index.ts src/fastify-plugin.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.0",
    "prom-client": "^15.1.0",
    "zod": "^3.22.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.48.0",
    "@opentelemetry/sdk-metrics": "1.21.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.48.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.48.0",
    "@opentelemetry/resources": "^1.21.0",
    "@opentelemetry/semantic-conventions": "^1.21.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "@types/node": "^20.0.0",
    "@aasop/config": "workspace:*",
    "@aasop/shared-kernel": "workspace:*"
  }
}
