{
  "name": "@aasop/security",
  "version": "0.1.0",
  "description": "Authentication, authorization, audit, and multi-tenant security for AASOP",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs",
      "types": "./dist/auth/index.d.ts"
    },
    "./rbac": {
      "import": "./dist/rbac/index.js",
      "require": "./dist/rbac/index.cjs",
      "types": "./dist/rbac/index.d.ts"
    },
    "./audit": {
      "import": "./dist/audit/index.js",
      "require": "./dist/audit/index.cjs",
      "types": "./dist/audit/index.d.ts"
    },
    "./tenant": {
      "import": "./dist/tenant/index.js",
      "require": "./dist/tenant/index.cjs",
      "types": "./dist/tenant/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/auth/index.ts src/rbac/index.ts src/audit/index.ts src/tenant/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/auth/index.ts src/rbac/index.ts src/audit/index.ts src/tenant/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "jose": "^5.2.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "eslint": "^8.57.0",
    "@aasop/config": "workspace:*",
    "@aasop/shared-kernel": "workspace:*",
    "@aasop/database": "workspace:*"
  }
}
